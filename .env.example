# Copy values into your process environment for local development.
# Do not commit real credentials. Django does not load .env files automatically.
# Optional in local DEBUG mode (an ephemeral key is generated when blank); required in production.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
COLLEGE_EMAIL_DOMAIN=gvpcew.ac.in

# Configure CORS and CSRF separately. For production, use the exact HTTPS
# Hostinger frontend origin in both variables (without a trailing slash).
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
CROSS_SITE_SESSION_COOKIES=False
SECURE_HSTS_SECONDS=0

# Optional Neon/PostgreSQL URL. URL-encode special characters in credentials.
# Leave unset for local SQLite. Production requires a PostgreSQL URL.
DATABASE_URL=
DB_CONN_MAX_AGE=0

# Legacy PostgreSQL fields remain supported for existing local environments.
# Prefer DATABASE_URL for Neon and Render deployments.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
