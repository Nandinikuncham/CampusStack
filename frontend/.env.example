# Local development uses Vite's same-origin /api proxy.
VITE_API_BASE_URL=/api/v1
VITE_DJANGO_PROXY_TARGET=http://127.0.0.1:8000

# For a production Vite build, override VITE_API_BASE_URL with the absolute URL,
# for example: https://campusstack-api.onrender.com/api/v1
# VITE_ values are embedded in browser assets. Never put secrets here.
